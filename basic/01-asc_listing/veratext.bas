100 REM SOME VERA SCREEN STUFF
115 CLS:PRINT:PRINT:PRINT "PRESS <ESC> TO EXIT"
110 D=1:REM STARTING COLOR
120 FOR C=1 TO 26:REM CHARS A TO Z
130 FOR N=0 TO 40:REM 40 CHARS IN A ROW
135 REM TOP LINE OF SCREEN
140 VPOKE 1,$B000+(N*2),C
150 VPOKE 1,$B001+(N*2),D
160 GOSUB 1100
170 NEXT N
180 D=D+1
181 IF D > 15 THEN D = 1

190 GOSUB 2000
200 NEXT C
210 GOTO 120

1000 GOTO 9999

1100 REM DELAY LOOP
1110 FOR S=1 TO 64
1120 NEXT S
1130 RETURN

2000 REM KEYBOARD CHECK
2010 GET A$
2020 A=ASC(A$)
2030 IF A = 27 GOTO 9999
2040 RETURN

9999 END
