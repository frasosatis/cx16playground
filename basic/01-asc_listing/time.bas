1000 REM THIS IS AN EXAMPLE FOR TIME
1010 REM IF TIME$ IS ALWAYS "000000", START X16EMU with -RTC (LOWERCASE)
1020 PRINT TIME$
1025 PRINT LEFT$(TIME$,2);":";MID$(TIME$,3,2);":";RIGHT$(TIME$,2)
1030 IF TIME$="000000" THEN GOTO 2000
1040 END
2000 PRINT "RESTART X16EMU WITH PARAMETER -RTC, SEE README.MD FOR DETAILS."
2010 END
