10 REM SIMPLE COLOR SELECT
20 PRINT CHR$(147);"WELCOME TO A SMALL COLOR SELECT EXAMPLE"
30 PRINT "USE THE CURSOR KEYS LEFT/RIGHT TO ADJUST COLOR."
35 GOSUB 500
40 C=0:CP=0:REM BLACK

100 GET A$:A=ASC(A$)
110 IF A = 27 GOTO 999
120 REM IF A > 0 THEN PRINT A
130 IF A = 157 THEN GOSUB 700
140 IF A = 29 THEN GOSUB 800

200 IF C <> CP THEN GOSUB 600

290 GOTO 100

500 PRINT "COLOR TABLE:"
510 FOR I=0 TO 15
520 COLOR I:PRINT STR$(I);" ";
530 NEXT I
540 COLOR 1
550 PRINT:PRINT
560 RETURN

600 COLOR 1
610 PRINT "COLOR SELECTED: ";C;:CP = C
620 COLOR C
630 PRINT "COLORED EXAMPLE TEXT"
640 RETURN

700 REM COLOR DEC
710 IF C > 0 THEN C = C - 1
790 RETURN

800 REM COLOR INC
810 IF C < 15 THEN C = C + 1
890 RETURN

999 END
