100 REM SIMPLE FILE WRITING EXAMPLE
105 REM FILE NUMBER = 1
106 REM DISK = 8
107 REM CHANNEL = 2
110 REM SEQUENTIAL FILE
113 REM @: TO OVERWRITE FILE IF ALREADY EXISTING
115 PRINT "WRITING FILE."
120 OPEN 1,8,2,"@:HELLOTXT,S,W"
125 PRINT#1,DATE$
130 PRINT#1,"SIMPLE TEXT FILE CREATED ON COMMANDER X16"
140 PRINT#1,"LINE ENDS WILL USE $0D WHICH MIGHT CAUSE TROUBLE"
150 PRINT#1,"IN SOME EDITORS / ENVIRONMENTS"
160 CLOSE 1
170 REM ===================================================
190 PRINT "READING FILE."
200 OPEN 2,8,2,"HELLOTXT,S,R"
210 GET#2,D$
220 PRINT D$;
230 IF ST GOTO 250
240 GOTO 210
250 CLOSE 2
