1001 REM FROM WIKIPEDIA'S BASIC ARTICLE
1002 REM https://de.wikipedia.org/wiki/BASIC
1003 REM
1010 INPUT "PLEASE ENTER YOUR NAME: "; A$
1020 PRINT "HELLO, "; A$
1030 INPUT "HOW MANY STARS DO YOU WANT"; S
1035 S$ = ""
1040 FOR I = 1 TO S
1050 S$ = S$ + "*"
1055 NEXT I
1060 PRINT S$
1070 INPUT "DO YOU WANT MORE STARS"; Q$
1080 IF LEN(Q$) = 0 THEN GOTO 1070
1090 L$ = LEFT$(Q$, 1)
1100 IF (L$ = "J") OR (L$ = "j") THEN GOTO 1030
1101 IF (L$ = "Y") OR (L$ = "y") THEN GOTO 1030
1110 PRINT "GOOD BYE: ";
1120 FOR I = 1 TO 10
1130 PRINT A$; " ";
1140 NEXT I
1150 PRINT
1160 END
